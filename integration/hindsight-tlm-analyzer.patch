+class TlmQueryAnalyzer(QueryAnalyzer):
+    """Query analyzer backed by tlm: a tiny multilingual date model that runs on numpy only.
+
+    Opt in with ``HINDSIGHT_API_QUERY_ANALYZER=tlm``; dateparser stays the default. Same contract
+    as DateparserQueryAnalyzer: one window per query (tlm's first range), whole days, naive
+    datetimes. tlm returns several ranges for questions that name several ("May 2025 and June
+    2026"); recall takes one window today, so the first is used. Open ends ("before 2020") become
+    the widest dates datetime can hold.
+    """
+
+    _OPEN_START = datetime(1, 1, 1)
+    _OPEN_END = datetime(9999, 12, 31, 23, 59, 59, 999999)
+
+    def __init__(self) -> None:
+        self._parser = None
+
+    def load(self) -> None:
+        if self._parser is None:
+            from tlm.runtime import Parser
+
+            self._parser = Parser()
+
+    def analyze(self, query: str, reference_date: datetime | None = None) -> QueryAnalysis:
+        if reference_date is None:
+            reference_date = default_reference_date()
+        self.load()
+        ranges = self._parser.parse(query, reference_date)
+        if not ranges:
+            return QueryAnalysis(temporal_constraint=None)
+        first = ranges[0]
+        start = datetime.combine(first.start, time.min) if first.start else self._OPEN_START
+        end = datetime.combine(first.end, time.max) if first.end else self._OPEN_END
+        return QueryAnalysis(temporal_constraint=TemporalConstraint(start_date=start, end_date=end))
diff --git a/hindsight-api-slim/tests/test_tlm_query_analyzer.py b/hindsight-api-slim/tests/test_tlm_query_analyzer.py
