@@ -0,0 +1,50 @@
+"""TlmQueryAnalyzer: the opt-in tlm date model (HINDSIGHT_API_QUERY_ANALYZER=tlm)."""
+
+from datetime import datetime
+
+import pytest
+
+pytest.importorskip("tlm")
+
+from hindsight_api.engine.query_analyzer import TlmQueryAnalyzer  # noqa: E402
+
+REF = datetime(2026, 11, 17, 14, 30)
+
+
+@pytest.fixture(scope="module")
+def tlm_analyzer():
+    a = TlmQueryAnalyzer()
+    a.load()
+    return a
+
+
+@pytest.mark.parametrize(
+    "query, expected",
+    [
+        ("what did I decide yesterday", "2026-11-16 to 2026-11-16"),
+        ("in the last 6 months", "2026-05-17 to 2026-11-17"),
+        ("¿qué hice hace 3 días?", "2026-11-14 to 2026-11-14"),
+        ("上周一", "2026-11-09 to 2026-11-09"),
+        ("letzte Woche", "2026-11-09 to 2026-11-15"),
+    ],
+)
+def test_dates(tlm_analyzer, query, expected):
+    assert str(tlm_analyzer.analyze(query, REF).temporal_constraint) == expected
+
+
+@pytest.mark.parametrize("query", ["how does the reranker work", "", "release 2.1 notes", "port 8080"])
+def test_no_date(tlm_analyzer, query):
+    assert tlm_analyzer.analyze(query, REF).temporal_constraint is None
+
+
+def test_open_end_and_whole_days(tlm_analyzer):
+    c = tlm_analyzer.analyze("before 2020", REF).temporal_constraint
+    assert c.start_date == datetime(1, 1, 1) and c.end_date == datetime(2019, 12, 31, 23, 59, 59, 999999)
+
+
+def test_engine_picks_tlm_from_env(monkeypatch):
+    from hindsight_api.engine import memory_engine
+
+    monkeypatch.setenv("HINDSIGHT_API_QUERY_ANALYZER", "tlm")
+    src = open(memory_engine.__file__).read()
+    assert 'os.getenv("HINDSIGHT_API_QUERY_ANALYZER", "dateparser")' in src and "TlmQueryAnalyzer()" in src
